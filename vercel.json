{
  "version": 2,
  "framework": "nextjs",
  "functions": {
    "pages/api/**/*.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/process-media",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/auto-archive",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/calendar-sync",
      "schedule": "0 4 * * *"
    }
  ]
}
