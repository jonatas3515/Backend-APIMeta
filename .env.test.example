# Environment variables for testing
# Copy this file to .env.test and fill with test values
# NEVER commit .env.test with real credentials

# Supabase (use local instance or mock)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=your-mock-service-key-here

# Google AI (Gemini) - will be mocked in tests
GOOGLE_AI_API_KEY=your-mock-google-ai-key-here

# WhatsApp Meta Cloud API - will be mocked in tests
WHATSAPP_TOKEN=your-mock-whatsapp-token-here
WHATSAPP_PHONE_NUMBER_ID=your-mock-phone-id-here
WEBHOOK_VERIFY_TOKEN=your-mock-verify-token-here

# DataJud - will be mocked in tests
DATAJUD_API_KEY=your-mock-datajud-key-here

# Test environment
NODE_ENV=test
